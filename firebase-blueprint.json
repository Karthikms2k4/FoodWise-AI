{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and sustainability milestone records",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User unique identifier matching auth UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "avatarUrl": {
          "type": "string",
          "description": "User avatar image URL"
        },
        "ecoScore": {
          "type": "number",
          "description": "Composite sustainability eco score (0-100)"
        },
        "totalSavedDollars": {
          "type": "number",
          "description": "Cumulative dollars saved by preventing food waste"
        },
        "co2PreventedKg": {
          "type": "number",
          "description": "Cumulative kilograms of CO2 emissions prevented"
        },
        "wasteReductionRate": {
          "type": "number",
          "description": "Percentage of food waste prevented this month"
        },
        "householdSize": {
          "type": "number",
          "description": "Number of people in household"
        },
        "dietaryPreference": {
          "type": "string",
          "description": "Dietary restriction or preference"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "name", "email"]
    },
    "FoodItem": {
      "title": "FoodItem",
      "description": "Pantry food inventory item tracked for shelf life",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the food item"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Name of the food product"
        },
        "category": {
          "type": "string",
          "enum": ["Produce", "Dairy", "Bakery", "Meat & Seafood", "Pantry", "Beverages"],
          "description": "Category of food item"
        },
        "quantity": {
          "type": "string",
          "maxLength": 60,
          "description": "Package or portion quantity description"
        },
        "location": {
          "type": "string",
          "enum": ["Fridge Crisper", "Fridge Top Shelf", "Fridge Door", "Freezer", "Counter Basket", "Pantry Shelf"],
          "description": "Storage location inside the kitchen"
        },
        "daysRemaining": {
          "type": "number",
          "description": "Estimated days before food expires"
        },
        "expiryDateText": {
          "type": "string",
          "maxLength": 60,
          "description": "Human readable expiry label"
        },
        "status": {
          "type": "string",
          "enum": ["optimal", "expiring_soon", "expired"],
          "description": "Current freshness status"
        },
        "imageUrl": {
          "type": "string",
          "description": "Product image thumbnail URL"
        },
        "co2ImpactKg": {
          "type": "number",
          "description": "Estimated carbon footprint in kilograms"
        },
        "estCost": {
          "type": "number",
          "description": "Estimated cost value in USD"
        },
        "addedDate": {
          "type": "string",
          "description": "Date food was added to pantry"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "name", "category", "location", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Food expiry and pantry milestone alert",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "maxLength": 140,
          "description": "Alert title"
        },
        "message": {
          "type": "string",
          "maxLength": 400,
          "description": "Detailed notification text"
        },
        "timestamp": {
          "type": "string",
          "description": "Relative or formatted display time"
        },
        "type": {
          "type": "string",
          "enum": ["warning", "alert", "success", "tip"],
          "description": "Alert severity category"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the user has marked this alert as read"
        },
        "itemId": {
          "type": "string",
          "description": "Associated food item ID if applicable"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "title", "message", "type", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile with eco scores, household settings, and waste stats"
    },
    "/users/{userId}/foodItems/{itemId}": {
      "schema": { "$ref": "FoodItem" },
      "description": "Pantry inventory items owned and managed by the user"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "Alert notifications for expiring items and milestones"
    }
  }
}
